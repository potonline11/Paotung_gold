# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in Vercel Environment Variables or AI Studio Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather on Telegram.
# Configure this in Vercel Environment Variables or AI Studio Secrets panel.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# TELEGRAM_CHAT_ID: Target Telegram Group / Channel Chat ID (e.g., -1001234567890 or @channelname).
# Configure this in Vercel Environment Variables or AI Studio Secrets panel.
TELEGRAM_CHAT_ID="MY_TELEGRAM_CHAT_ID"
